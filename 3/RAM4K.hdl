// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    /** Group smaller RAM parts together
    RAM's address input consists of 2 fields:
    - 3 MSB bits address [9..11] select which RAM-part
    - 9 next bits address [0..8] select address within 
    that RAM-part */

    /** Set the actual load to one of the RAM parts using
    DMux and the selected RAM-part. 
    This could be 0 or 1, but the remaining loads will 
    default to 0 so will not be effective. 
    This stores the input into the correct RAM part and 
    its register if load is asserted in sequential logic 
    (next statement) */
    DMux8Way(in=load , sel=address[9..11] , 
    a=load0 , b=load1 , c=load2 , d=load3 , 
    e=load4 , f=load5 , g=load6 , h=load7 );

    /** Feed the in value to all RAM parts simultaneously
    to get their different outputs with 
    loads already determined (previous step) and correct address*/
    RAM512(in=in , load=load0, address=address[0..8] , out=out0 );
    RAM512(in=in , load=load1 , address=address[0..8] , out=out1 );
    RAM512(in=in , load=load2 , address=address[0..8] , out=out2 );
    RAM512(in=in , load=load3 , address=address[0..8] , out=out3 );
    RAM512(in=in , load=load4 , address=address[0..8] , out=out4 );
    RAM512(in=in , load=load5 , address=address[0..8] , out=out5 );
    RAM512(in=in , load=load6 , address=address[0..8] , out=out6 );
    RAM512(in=in , load=load7 , address=address[0..8] , out=out7 );

    /** Get RAM4K's output from one of the retrieved outputs
    using Mux and the RAM-part we need (1st field of address)*/
    Mux8Way16(a=out0 , b=out1 , c=out2 , d=out3 , 
    e=out4 , f=out5 , g=out6 , h=out7 , 
    sel= address[9..11] , out=out);
}