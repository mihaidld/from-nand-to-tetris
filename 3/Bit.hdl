// File name: projects/3/a/Bit.hdl
/**
 * 1-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    /** Use multiplexer to select between current state 
    and new input in based on 
    selection bit load, then plug result into outMux*/
    Mux(a=state , b=in, sel=load , out= outMux);
    /** plug result of Mux into DFF which produces 
    current output out(t) out and also sets the value of
    state for next iteration of the loop when MUX is
    going to be evaluated */
    DFF(in=outMux , out=state, out = out );

    
}