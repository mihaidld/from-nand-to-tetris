/** Hello World program */
class Main {
    function void main(){
        var Array a;
        var int length;
        var int i, sum;
        // get input from user
        let length = Keyboard.readInt("How many numbers? ");

        //constructs the array
        let a = Array.new(length);
        let i = 0;
        while(i < length){
            let a[i] = Keyboard.readInt("Enter a number: ");
            let sum = sum + a[i];
            let i = i + 1;
        }
        /* Prints some text using the stadard library*/
        do Output.printString("The average is: ");
        do Output.printInt(sum / length); // int supported (no float)
        return;
    }
}