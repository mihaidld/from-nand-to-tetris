/** This class provides functions for reading inputs 
from a standard keyboard.*/
class Keyboard{
    static int KBD;
    
    /** Initializes the keyboard. */
    function void init() {
        let KBD = 24576;
        return;
    } 

    /** Returns ASCII code as character of the currently pressed key on the keyboard; 
    if no key is currently pressed, returns 0. 
    Recognizes all the values in the Hack character set (see appendix 5). 
    These include the characters newLine (128, return value of String.newLine()), 
    backSpace (129, return value of String.backSpace ()), 
    leftArrow (130), upArrow (131), rightArrow (132), downArrow (133), 
    home (134), end (135), pageUp (136), pageDown (137), 
    insert (138), delete (139), esc (140), and f1–f12 (141–152). */
    function char keyPressed(){
        // var char key;
        // let key = Memory.peek(24576);//takes a peek at currently pressed
        // return key;
        return Memory.peek(KBD);
    }

    /** Waits until a keyboard key is pressed and released,
    then displays the corresponding character on the screen, 
    advances the cursor and returns the character. */
    function char readChar(){
        var char current, c;
        var boolean toWait;

        // displayCursor
        // do Output.printChar(0);
        // waits until key pressed, sample keyboard
        let toWait = true;
        while(toWait){
            let current = Keyboard.keyPressed();
            // capture key pressed
            if (current > 0){
                let toWait = false;
                let c = current;
            }
        }
        
        // waits until key released
        let toWait = true;
        while(toWait){
            let current = Keyboard.keyPressed();
            if (current = 0){
                let toWait = false;
            }
        }
        // give the user some feedback
        // display c at the current cursor location
        do Output.printChar(c);
        // advance cursor
        // do Output.printChar(0);
        return c;
    }

    /** Displays the message, reads from the keyboard 
    the entered string  of characters 
    until a newLine character is detected, 
    displays the string on the screen, and 
    returns the string. 
    Also handles user backspaces. */
    function String readLine(String message){
        var String str, strPrev;
        var char current, c;//current char
        var int i, len;//length of str
        var boolean reading;
        do Output.printString(message);
        let len = 50;//initial max length
        let str = String.new(len);//start with empty string of max length 50
        let reading = true;
        while(reading){
            let c = Keyboard.readChar();
            // newline
            if (c = 128){
                //display newline
                do Output.println();
                let reading = false;
            }
            else {// backspace
                if(c = 129){
                    // remove last char from str
                    do str.eraseLastChar();
                    do Output.backSpace();
                }
                // other char: append it, increase string's maxlength
                else{
                    // reached end of current max length
                    if (str.length() = len){
                        let strPrev = str;//remember previous value
                        let str = String.new(len + 50);//add extra 50 chars
                        let i = 0;
                        let current = c;//remember current char
                        // copy previous str into new longer string
                        // sequence: get char from strPrev and copy it into str
                        while(i < len){
                            do str.appendChar(strPrev.charAt(i));
                            let i = i + 1;
                        }
                    }
                    let str = str.appendChar(c);
                }
            }
        }
        return str;
    }

    /** Displays the message, reads from the keyboard the entered string 
    of characters until a newLine character is detected, 
    displays the string on the screen, and returns its integer value
    until the first non-digit character in the entered string is detected. 
    Also handles user backspaces.*/
    function int readInt(String message){
        var String str;
        let str = Keyboard.readLine(message);
        return str.intValue();
    }
}